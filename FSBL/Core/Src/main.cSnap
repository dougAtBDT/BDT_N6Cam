	  RCC_ClkInitStruct.IC11Selection.ClockSelection = RCC_ICCLKSOURCE_PLL1;
	  RCC_ClkInitStruct.IC11Selection.ClockDivider = 3;

	  if (HAL_RCC_ClockConfig(&RCC_ClkInitStruct) != HAL_OK)
